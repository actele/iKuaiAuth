# iKuai 网页认证服务配置示例

# ============================================
# 示例1: 本地用户名密码认证（默认方式）
# ============================================
server:
  host: "0.0.0.0"
  port: "8088"
  debug: false              # 调试模式：true=显示详细日志和调试信息，false=生产模式

ikuai:
  portal_url: "https://portal.ikuai8-wifi.com/Action/webauth-up"
  app_key: "your_app_key_here"  # 从爱快云平台获取的 AppKey

auth:
  method: "simple"          # 认证方式：simple (本地用户名密码) | api (外部API验证)
  simple_users:             # 用户列表
    user01: "password123"
    admin: "admin888"
    test: "test123"

# ============================================
# 示例2: 外部API认证
# ============================================
# 将 auth.method 改为 "api" 并配置以下内容：
#
# auth:
#   method: "api"
#   
#   # 外部API认证配置
#   api:
#     url: "https://your-domain.com/api/auth/verify"  # 您的认证API地址
#     method: "POST"                                    # 请求方法：GET 或 POST
#     timeout: 5                                        # 超时时间（秒）
#     
#     # 请求头配置
#     headers:
#       Content-Type: "application/json"
#       Authorization: "Bearer your-api-token-here"
#       X-API-Key: "your-api-key"
#     
#     # 请求体模板（仅POST时使用），{{username}} 和 {{password}} 会被自动替换
#     body_template: |
#       {
#         "username": "{{username}}",
#         "password": "{{password}}",
#         "source": "ikuai-portal"
#       }
#     
#     # 响应验证配置
#     response:
#       success_field: "success"      # API响应中表示成功的字段名
#       success_value: true            # 成功时该字段的值（可以是 true/false 或字符串）
#       message_field: "message"       # 错误消息字段名（可选）

# ============================================
# 示例3: 网络设备认证（使用API模式）
# ============================================
# 网络设备认证也使用 "api" 模式，通过特定的请求格式实现：
#
# auth:
#   method: "api"
#   
#   api:
#     url: "http://192.168.1.100:8000/api/v1/network-auth/authenticate"
#     method: "POST"
#     timeout: 5
#     
#     headers:
#       Content-Type: "application/json"
#       X-API-Version: "v1"
#     
#     # 网络设备认证请求格式
#     # 说明: 前端用户名→user_account，密码→mac_address
#     body_template: |
#       {
#         "device_number": "",
#         "user_account": "{{username}}",
#         "vpn_number": "",
#         "mac_address": "{{password}}",
#         "ip_address": "auto",
#         "system_id": 1
#       }
#     
#     # API返回格式: {"code": 0, "msg": "成功", "data": {...}}
#     response:
#       success_field: "code"
#       success_value: 0
#       message_field: "msg"
#
# 用户信息映射:
#   - API返回的 data.username → iKuai的 user_id / custom_name
#   - API返回的 data.real_name → iKuai的 name
#   - API返回的 data.phone → iKuai的 phone
#
# 详细文档: docs/NETWORK_AUTH.md 和 docs/API_AUTH.md

# ============================================
# API响应格式说明
# ============================================
# 
# 您的API应该返回JSON格式的响应，例如：
#
# 成功时:
# {
#   "success": true,
#   "message": "认证成功",
#   "data": {...}
# }
#
# 失败时:
# {
#   "success": false,
#   "message": "用户名或密码错误"
# }
#
# ============================================
# 其他API响应格式示例
# ============================================
#
# 格式1: 状态码型 {"code": 0, "msg": "ok", "data": {...}}
# 配置:
#   response:
#     success_field: "code"
#     success_value: 0
#     message_field: "msg"
#
# 格式2: 字符串型 {"status": "success", "error": null}
# 配置:
#   response:
#     success_field: "status"
#     success_value: "success"
#     message_field: "error"
#
# 格式3: 嵌套字段 {"code": 200, "data": {"allowed": true}}
# 配置:
#   response:
#     success_field: "code"
#     success_value: 200
#     message_field: "data.reason"

# ============================================
# 快速开始
# ============================================
# 1. 复制配置: cp config.yaml.example config.yaml
# 2. 修改 AppKey: 将 your_app_key_here 改为实际值
# 3. 选择认证模式:
#    - 本地认证: method: "simple"（默认）
#    - API认证: method: "api"（需配置 api 部分）
# 4. 重启服务: sudo systemctl restart ikuai-auth
# 5. 查看日志: sudo journalctl -u ikuai-auth -f
#
# 详细文档:
#   - 部署指南: docs/DEPLOYMENT.md
#   - API认证: docs/API_AUTH.md
#   - 网络认证: docs/NETWORK_AUTH.md
